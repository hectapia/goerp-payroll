#
# GoERP Payroll - Main Application Service
#
# This systemd unit file manages the GoERP Payroll web application.
#
# Installation:
#   1. Copy this file to /etc/systemd/system/goerp-payroll.service
#   2. Edit the Environment variables below to match your deployment
#   3. Run: sudo systemctl daemon-reload
#   4. Run: sudo systemctl enable goerp-payroll
#   5. Run: sudo systemctl start goerp-payroll
#
# Usage:
#   - Start:   sudo systemctl start goerp-payroll
#   - Stop:    sudo systemctl stop goerp-payroll
#   - Restart: sudo systemctl restart goerp-payroll
#   - Status:  sudo systemctl status goerp-payroll
#   - Logs:    sudo journalctl -u goerp-payroll -f

[Unit]
Description=GoERP Payroll Application
Documentation=https://github.com/williamjmorenor/coati-payroll
After=network.target postgresql.service redis.service
Wants=goerp-payroll-worker.service

[Service]
Type=simple
User=coati
Group=coati
WorkingDirectory=/home/coati/goerp-payroll

# Path to Python virtual environment
Environment="PATH=/home/coati/goerp-payroll/venv/bin"

# Database configuration
Environment="DATABASE_URL=postgresql://coati_user:CHANGE_ME@localhost:5432/coati_db"

# Security
Environment="SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET"

# Admin credentials
Environment="ADMIN_USER=admin"
Environment="ADMIN_PASSWORD=CHANGE_ME"

# Application settings
Environment="PORT=5000"
Environment="MAX_CONTENT_LENGTH=2097152"

# Queue system (requires Redis and goerp-payroll-worker.service)
Environment="QUEUE_ENABLED=1"
Environment="REDIS_URL=redis://localhost:6379/0"
Environment="BACKGROUND_PAYROLL_THRESHOLD=100"

# Session storage (optional, uses Redis if configured)
Environment="SESSION_REDIS_URL=redis://localhost:6379/1"

# Start the application
ExecStart=/home/coati/goerp-payroll/venv/bin/python /home/coati/goerp-payroll/app.py

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goerp-payroll

[Install]
WantedBy=multi-user.target
